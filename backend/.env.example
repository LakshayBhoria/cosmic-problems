PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins (no trailing slash).
CLIENT_URL=http://localhost:5173

NODE_ENV=production
MAX_UPLOAD_MB=100

# --- Firebase (Firestore only — data, not media) ---
# Firebase Console → Project settings → Service accounts → Generate new
# private key. That downloads a JSON file — base64-encode its contents and
# paste the result here as one line. This keeps a multiline secret out of
# your env var UI.
#   macOS/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Cloudinary (image/video uploads) ---
# Free tier, no card required: cloudinary.com → sign up → Dashboard shows
# all three values below immediately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
